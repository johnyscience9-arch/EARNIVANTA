# Local development only. Never commit real credentials.
APP_ENV=development
DATABASE_URL=sqlite:///./earnivanta.db
TOKEN_SECRET=
TOKEN_TTL_HOURS=24
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional first-admin bootstrap. Remove ADMIN_PASSWORD after first admin creation.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Brevo SMTP: registration and password reset fail closed until all required values are set.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EARNIVANTA
FRONTEND_URL=https://earnivanta.pages.dev

# Admin MFA is mandatory in production; set false only for local development.
ADMIN_MFA_REQUIRED=false
